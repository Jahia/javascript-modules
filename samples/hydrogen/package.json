{
  "name": "hydrogen",
  "version": "1.3.0-SNAPSHOT",
  "type": "module",
  "files": [
    "dist",
    "src/**/*.cnd",
    "settings",
    "static"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && run package",
    "clean": "rm -rf dist/",
    "deploy": "jahia-deploy",
    "format": "prettier --write --list-different .",
    "lint": "eslint .",
    "package": "yarn pack --out dist/package.tgz",
    "dev": "vite build --watch",
    "watch": "run dev",
    "watch:callback": "run package && run deploy"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "modern-normalize": "^3.0.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.19.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@jahia/javascript-modules-library": "workspace:^",
    "@jahia/vite-plugin": "workspace:^",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "i18next": "^26.4.2",
    "prettier": "^3.9.7",
    "react": "^19.3.0",
    "react-i18next": "^17.0.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=4.0.0"
  },
  "jahia": {
    "snapshot": true,
    "module-dependencies": "default",
    "module-type": "templatesSet",
    "server": "dist/server/index.js",
    "static-resources": "/dist/client,/dist/assets,/locales,/images,/icons"
  }
}
